# ConsentGuard environment configuration (TEMPLATE - placeholders only).
# Copy to ".env" in the project root, or run:  python scripts/setup_env.py
# Never commit the real .env file.

# Runtime profile: development | production
CG_ENV=development

# AES-256-GCM key for protected records and MFA secrets.
# Must be 32 random bytes, URL-safe base64 encoded (44 characters).
# Generate with: python scripts/setup_env.py   (never overwrites an existing key)
CG_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_BASE64_KEY
# Identifier stored alongside each ciphertext so future key rotation is possible.
CG_ENCRYPTION_KEY_ID=k1

# SQLite database location (relative paths are resolved from backend/).
CG_DATABASE_URL=sqlite:///instance/consentguard.db

# Session cookie settings. Use CG_COOKIE_SECURE=true whenever served over HTTPS.
CG_COOKIE_SECURE=false
CG_SESSION_IDLE_MINUTES=30
CG_SESSION_ABSOLUTE_HOURS=8

# Investigators must have MFA enrolled and verified to use investigation features.
CG_REQUIRE_MFA_FOR_INVESTIGATORS=true

# Rate limits (Flask-Limiter syntax)
CG_LOGIN_RATE_LIMIT=5 per minute;30 per hour
CG_MFA_RATE_LIMIT=5 per minute;30 per hour

# Allowed browser origins for state-changing requests (comma separated).
CG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000
